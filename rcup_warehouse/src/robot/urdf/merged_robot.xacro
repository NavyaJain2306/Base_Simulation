      </geometry>
      <material
        name="">
        <color
          rgba="0.6 0.6 0.6 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/Link2.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Joint2"
    type="revolute">
    <origin
      xyz="${0.0493654257105637 * arm_scale} ${0.0629674380302429 * arm_scale} ${0.096866312640014 * arm_scale}"
      rpy="-0.853422783514298 0.0375562443434387 0.921651311234904" />
    <parent
      link="Link1" />
    <child
      link="Link2" />
    <axis
      xyz="-0.998759127785777 0.0498016532315323 0" />

    <limit
        lower="-3.14"
        upper="3.14"
        effort="100"
        velocity="2.0"/>

    
    
  </joint>
  <link
    name="Link3">
    <inertial>
      <origin
        xyz="${-0.0918379209757132 * arm_scale} ${-0.0967945193198121 * arm_scale} ${0.102996208510192 * arm_scale}"
        rpy="0 0 0" />
      <mass
        value="${0.547836436672922 * arm_scale**3}" />
      <inertia
        ixx="${0.0072917470598008 * arm_scale**5}"
        ixy="${3.63924247489624E-07 * arm_scale**5}"
        ixz="${-6.45426763974438E-06 * arm_scale**5}"
        iyy="${0.00393800602451967 * arm_scale**5}"
