    </visual>
    <collision>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/Link3.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Joint3"
    type="revolute">
    <origin
      xyz="${0.0150729083014778 * arm_scale} ${-0.149509002764561 * arm_scale} ${0.330901216092781 * arm_scale}"
      rpy="0 0 0" />
    <parent
      link="Link2" />
    <child
      link="Link3" />
    <axis
      xyz="-0.998759127785812 0.0498016532308395 0" />
    <limit
        lower="-3.14"
        upper="3.14"
        effort="100"
        velocity="2.0"/>
  </joint>
  <link
    name="Link4">
    <inertial>
      <origin
        xyz="${0.0918334014088884 * arm_scale} ${-0.00458203523122802 * arm_scale} ${0.00672183601259446 * arm_scale}"
        rpy="0 0 0" />
      <mass
        value="${0.462803643323728 * arm_scale**3}" />
      <inertia
        ixx="${0.00059732911228678 * arm_scale**5}"
        ixy="${8.73335696458294E-06 * arm_scale**5}"
        ixz="${-7.44079317387951E-05 * arm_scale**5}"
        iyy="${0.000772721879623989 * arm_scale**5}"
        iyz="${3.66965518616369E-06 * arm_scale**5}"
        izz="${0.000780971939008755 * arm_scale**5}" />
    </inertial>
    <visual>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
