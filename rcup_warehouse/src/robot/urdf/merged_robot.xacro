<?xml version="1.0" encoding="utf-8"?>
<robot
  name="mecanum_arm_robot"
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  xmlns:ignition="http://ignitionrobotics.org">

  <material name="base_chassis">
    <color rgba="0.16 0.18 0.20 1.0" />
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.06 1.0" />
  </material>
  <material name="accent_orange">
    <color rgba="0.95 0.46 0.08 1.0" />
  </material>
  <material name="arm_light_grey">
    <color rgba="0.82 0.83 0.85 1.0" />
  </material>
  <material name="gripper_dark">
    <color rgba="0.18 0.19 0.21 1.0" />
  </material>
  <material name="finger_black">
    <color rgba="0.08 0.08 0.09 1.0" />
  </material>


  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.080885" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin
        xyz="0.0251818 0.0140581 4.35036e-05"
        rpy="0 0 3.1415" />
      <mass value="2.2136877" />
      <inertia
        ixx="0.0212574936"
        ixy="-0.0005908165"
        ixz="2.35651e-05"
        iyy="0.0577101959"
        iyz="-5.5932e-06"
        izz="0.0430343235" />
    </inertial>
    <!-- <visual>
      <origin xyz="0 0 0" rpy="0 0 3.1415" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.62745 0.62745 0.62745 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/base_link.STL" />
      </geometry>
    </collision> -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.1415" />
      <geometry>
        <box size="0.392 0.2772 0.097685" />
      </geometry>
      <material name="">
        <color rgba="0.62745 0.62745 0.62745 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.392 0.2772 0.097685" />
      </geometry>
    </collision>
  </link>

  <link name="front_right_wheel">
    <inertial>
      <origin
        xyz="3.901e-07 9.59e-08 0.016849"
        rpy="0 0 0" />
      <mass value="0.06237455" />
      <inertia
        ixx="1.57712e-05"
        ixy="1.35e-08"
        ixz="-1.295e-07"
        iyy="1.57465e-05"
        iyz="-7.03e-08"
        izz="2.75601e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0" />
      <geometry>
        <!-- <mesh
          filename="file://$(find robot)/meshes/front_left_wheel.STL"
          scale="1 1 1"/> -->
          <cylinder radius="0.0525" length="0.021" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0525"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.16135 -0.149275 -0.0245" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="front_right_wheel" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="front_left_wheel">
    <inertial>
      <origin
        xyz="3.903e-07 9.6e-08 -0.0163590346"
        rpy="0 0 0" />
      <mass value="0.0623739077" />
      <inertia
        ixx="1.57712e-05"
        ixy="1.35e-08"
        ixz="-1.295e-07"
        iyy="1.57465e-05"
        iyz="-7.03e-08"
        izz="2.75604e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0" />
      <geometry>
        <!-- <mesh
          filename="file://$(find robot)/meshes/front_right_wheel.STL"
          scale="1 -1 1"/> -->
        <cylinder radius="0.0525" length="0.021" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0525"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.161 0.149275 -0.0245" rpy="1.5708 0 3.1416" />
    <parent link="base_link" />
    <child link="front_left_wheel" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="back_left_wheel">
    <inertial>
      <origin
        xyz="3.901e-07 9.56e-08 0.016849"
        rpy="0 0 0" />
      <mass value="0.06237455" />
      <inertia
        ixx="1.57712e-05"
        ixy="1.35e-08"
        ixz="-1.295e-07"
        iyy="1.57465e-05"
        iyz="-7.03e-08"
        izz="2.75601e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <mesh filename="file://$(find robot)/meshes/back_left_wheel.STL" /> -->
        <cylinder radius="0.0525" length="0.021" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0525"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="-0.16135 0.149275 -0.0245" rpy="1.5708 0 3.1416" />
    <parent link="base_link" />
    <child link="back_left_wheel" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="back_right_wheel">
    <inertial>
      <origin
        xyz="3.908e-07 9.54e-08 -0.0163590347"
        rpy="0 0 0" />
      <mass value="0.0623739082" />
      <inertia
        ixx="1.57712e-05"
        ixy="1.35e-08"
        ixz="-1.295e-07"
        iyy="1.57465e-05"
        iyz="-7.03e-08"
        izz="2.75604e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <mesh
          filename="file://$(find robot)/meshes/back_right_wheel.STL"
          scale="1 -1 1"/> -->
        <cylinder radius="0.0525" length="0.021" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0525"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="-0.161 -0.149275 -0.0245" rpy="-1.5708 0 0" />
    <parent link="base_link" />
    <child link="back_right_wheel" />
    <axis xyz="0 0 1" />
  </joint>

  <gazebo reference="front_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.2</mu2>
            <fdir1 ignition:expressed_in="base_footprint">1 1 0</fdir1>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>10000000.0</kp>
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
        <emissive>0.0 0.0 0.0 0.0</emissive>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="front_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.2</mu2>
            <fdir1 ignition:expressed_in="base_footprint">1 -1 0</fdir1>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>10000000.0</kp>
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
        <emissive>0.0 0.0 0.0 0.0</emissive>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="back_left_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.2</mu2>
            <fdir1 ignition:expressed_in="base_footprint">1 1 0</fdir1>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>10000000.0</kp>
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
        <emissive>0.0 0.0 0.0 0.0</emissive>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="back_right_wheel">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.2</mu2>
            <fdir1 ignition:expressed_in="base_footprint">1 -1 0</fdir1>
          </ode>
        </friction>
        <contact>
          <ode>
            <kp>10000000.0</kp>
            <kd>100.0</kd>
          </ode>
        </contact>
      </surface>
    </collision>
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1.0</ambient>
        <diffuse>0.2 0.2 0.2 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
        <emissive>0.0 0.0 0.0 0.0</emissive>
      </material>
    </visual>
  </gazebo>

<link name="counterweight">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="2.032031"/>
    <inertia
      ixx="0.0016807" ixy="0" ixz="0"
      iyy="0.0016807" iyz="0"
      izz="0.0016807"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.07 0.07 0.035"/>
    </geometry>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.07 0.07 0.035"/>
    </geometry>
  </collision>
</link>

<joint name="counterweight_joint" type="fixed">
  <parent link="base_link"/>
  <child link="counterweight"/>
  <origin xyz="-0.126 -0.01785 0.035" rpy="0 0 0"/>
</joint>

  <!-- ============================================================
       5-DOF ARM
       Scaled independently from the base via the arm_scale property
       below. Change arm_scale to resize just the arm on top of
       base_link.
       ============================================================ -->
  <xacro:property name="arm_scale" value="1.0" />

  <joint name="arm_base_joint" type="fixed">
    <origin xyz="0.126 0.0 0.044" rpy="0.0 0.0 0.0" />
    <parent link="base_link" />
    <child link="arm_base" />
    <axis xyz="0.0 0.0 1.0" />
  </joint>

<link
    name="arm_base">
    <inertial>
      <origin
        xyz="${-0.000574318952514363 * arm_scale} ${8.71933369950284E-09 * arm_scale} ${0.0397387129538838 * arm_scale}"
        rpy="0 0 0" />
      <mass
        value="${0.845575675087858 * arm_scale**3}" />
      <inertia
        ixx="${0.00243283459144695 * arm_scale**5}"
        ixy="${-1.57084851372232E-11 * arm_scale**5}"
        ixz="${-3.94360358635638E-07 * arm_scale**5}"
        iyy="${0.00243672722771256 * arm_scale**5}"
        iyz="${2.47877793314836E-12 * arm_scale**5}"
        izz="${0.00477827472292116 * arm_scale**5}" />
    </inertial>
    <visual>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/arm_base.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/arm_base.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
      </geometry>
    </collision>
  </link>
  <link
    name="Link1">
    <inertial>
      <origin
        xyz="${0.0104672363505767 * arm_scale} ${0.0130037589567118 * arm_scale} ${0.0887514585269518 * arm_scale}"
        rpy="0 0 0" />
      <mass
        value="${0.294805326724156 * arm_scale**3}" />
      <inertia
        ixx="${0.000494520641136983 * arm_scale**5}"
        ixy="${7.71447578216477E-05 * arm_scale**5}"
        ixz="${-1.09087128391225E-05 * arm_scale**5}"
        iyy="${0.000526647392068225 * arm_scale**5}"
        iyz="${-1.32291209749821E-05 * arm_scale**5}"
        izz="${0.000275588636139406 * arm_scale**5}" />
    </inertial>
    <visual>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/Link1.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.627450980392157 0.627450980392157 0.627450980392157 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/Link1.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
      </geometry>
    </collision>
  </link>
  <joint
    name="Joint1"
    type="revolute">
    <origin
      xyz="${0 * arm_scale} ${0 * arm_scale} ${0.0637999999999999 * arm_scale}"
      rpy="0 0 0" />
    <parent
      link="arm_base" />
    <child
      link="Link1" />
    <axis
      xyz="0 0 1" />
    <limit
        lower="-3.14"
        upper="3.14"
        effort="100"
        velocity="2.0"/>
  </joint>

  
  <link
    name="Link2">
    <inertial>
      <origin
        xyz="${0.0145929085684511 * arm_scale} ${-0.095193497861495 * arm_scale} ${0.208704831834355 * arm_scale}"
        rpy="0 0 0" />
      <mass
        value="${0.615358469584155 * arm_scale**3}" />
      <inertia
        ixx="${0.00528683459717594 * arm_scale**5}"
        ixy="${-0.000107802293650622 * arm_scale**5}"
        ixz="${0.000217076740145559 * arm_scale**5}"
        iyy="${0.00432759833357079 * arm_scale**5}"
        iyz="${0.00166942026358935 * arm_scale**5}"
        izz="${0.00128996133901587 * arm_scale**5}" />
    </inertial>
    <visual>
