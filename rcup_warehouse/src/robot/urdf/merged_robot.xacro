    </visual>
    <collision>
      <origin
        xyz="${0 * arm_scale} ${0 * arm_scale} ${0 * arm_scale}"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find robot)/meshes/Link4.STL" scale="${arm_scale} ${arm_scale} ${arm_scale}" />
      </geometry>
    </collision>
  </link>

  <link name="tcp" />
  <joint name="end_effector" type="fixed">
    <parent link="Link5" />
    <child link="tcp" />
    <origin xyz="${0 * arm_scale} ${0 * arm_scale} ${0.1 * arm_scale}" rpy="0 0 0" />
  </joint>
  <joint
    name="Joint4"
    type="revolute">
    <origin
      xyz="${-0.0336807621063758 * arm_scale} ${-0.173467508873688 * arm_scale} ${0.177903552627862 * arm_scale}"
      rpy="0 0 0" />
    <parent
      link="Link3" />
    <child
      link="Link4" />
    <axis
      xyz="0.998759127785812 -0.0498016532308386 0" />
    <limit
        lower="-3.14"
        upper="3.14"
        effort="100"
        velocity="2.0"/>
  </joint>
  <link
    name="Link5">
    <inertial>
      <origin
        xyz="${5.16510475856435E-06 * arm_scale} ${0.000823289067492849 * arm_scale} ${0.0786324376939109 * arm_scale}"
        rpy="0 0 0" />
      <mass
        value="${0.365663275650567 * arm_scale**3}" />
      <inertia
