<?xml version="1.0" ?>
<robot name="mecanum_arm_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

      <!--IMU SENSOR-->
  <link name = "imu_link">
   <inertial>
    <mass value="${0.01 * 0.7**3}"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="${0.0000166 * 0.7**5}" ixy="0" ixz="0"
             iyy="${0.0000166 * 0.7**5}" iyz="0"
             izz="${0.0000166 * 0.7**5}"/>
  </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${0.1 * 0.7}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <plugin filename="libignition-gazebo-imu-system.so"
              name="ignition::gazebo::systems::Imu">
      </plugin>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
        <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
        <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
        <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
        <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
      </linear_acceleration>
    </imu>
    </sensor>
  </gazebo>



<!-- LIDAR SENSOR -->
  <link name="lidar_link">
  <inertial>
    <mass value="${0.1 * 0.7**3}"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertia ixx="${0.000166 * 0.7**5}" ixy="0" ixz="0"
             iyy="${0.000166 * 0.7**5}" iyz="0"
             izz="${0.000166 * 0.7**5}"/>
  </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- <origin xyz="${0.28 * 0.7} 0 ${0.25 * 0.7}" rpy="0 0 0"/> -->
    <!-- <origin xyz="0.25 0 ${0.25 * 0.7}" rpy="0 0 0"/> -->
    <origin xyz="0.25 0 0.08" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>/scan</topic>
      <visualize>true</visualize>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>640</samples>
            <resolution>1</resolution>
            <min_angle>-1.5708</min_angle>
            <max_angle>1.5708</max_angle>
          </horizontal>

          <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
            </vertical>

        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
  <!-- Camera-stuff -->


</robot>